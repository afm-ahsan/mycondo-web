# MyCondo Web — local environment template.
# Copy to `.env` and fill in. NEVER commit `.env`.

# Backend API base URL (mycondo-api) — see docs/local-development-ports.md.
# Use the HTTP fallback port (5219), not the HTTPS port (7219): this dev server runs on plain HTTP,
# and browsers classify http/https on the same host as cross-site ("schemeful same-site"), which
# blocks the SameSite=Strict mycondo_rt cookie on refresh. Matching schemes keeps the session-restore
# flow (useSessionBootstrap) working across page reloads, matching how same-scheme HTTPS subdomains
# behave in production.
VITE_MYCONDO_API_BASE_URL=http://localhost:5219

# App identity
VITE_MYCONDO_APP_NAME=MyCondo
VITE_MYCONDO_ENV=development

# Optional — for staging/production debugging
# VITE_MYCONDO_SENTRY_DSN=
# VITE_MYCONDO_LOG_LEVEL=info
