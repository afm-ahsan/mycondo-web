# MyCondo Web — local environment template.
# Copy to `.env` and fill in. NEVER commit `.env`.

# Backend API base URL (mycondo-api) — see docs/local-development-ports.md
VITE_MYCONDO_API_BASE_URL=https://localhost:7219

# App identity
VITE_MYCONDO_APP_NAME=MyCondo
VITE_MYCONDO_ENV=development

# Optional — for staging/production debugging
# VITE_MYCONDO_SENTRY_DSN=
# VITE_MYCONDO_LOG_LEVEL=info
