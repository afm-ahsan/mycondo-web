# MyCondo Web — Vitest environment. Checked in (see .gitignore's `!.env.test`) so the test suite's
# MSW handlers (hardcoded to https://localhost:7219 across the test files) stay stable regardless of
# which port a developer's local .env points the dev server at (see docs/local-development-ports.md
# for why local dev now targets the HTTP fallback, :5219).
VITE_MYCONDO_API_BASE_URL=https://localhost:7219

VITE_MYCONDO_APP_NAME=MyCondo
VITE_MYCONDO_ENV=development
