  "components": {
    "schemas": {
      "AssignRoleToUserRequest": {
        "required": [
          "userId",
          "buildingId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "buildingId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "AuthenticatedUserDto": {
        "required": [
          "userId",
          "tenantId",
          "email",
          "fullName",
          "roles",
          "permissions",
          "buildingIds",
          "buildingPermissions"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buildingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "buildingPermissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuildingPermissionGrant"
            }
          }
        },
        "description": "Permissions holds only tenant-wide grants (from role assignments with no\r\n        building scope) — this is exactly what the JWT's `perm` claim carries, so the two stay in sync.\r\n        Building-scoped grants live separately in BuildingPermissions (the JWT's\r\n        `bperm` claim) precisely so a permission held only for Building A can't be mistaken for a\r\n        tenant-wide grant that would also apply to Building B. See ADR-014."
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAtUtc",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          }
        },
        "description": "The public wire shape of Register/Login/Refresh — everything AuthTokensDto carries except the\r\nrefresh token, which never leaves the server as a JSON field (see RefreshTokenCookie)."
      },
      "BuildingPermissionGrant": {
        "required": [
          "buildingId",
          "permission"
        ],
        "type": "object",
        "properties": {
          "buildingId": {
            "type": "string",
            "format": "uuid"
          },
          "permission": {
            "type": "string"
          }
        },
        "description": "A permission granted to the user, scoped to exactly one building."
      },
